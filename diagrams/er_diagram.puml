@startuml
entity Customer {
  * customer_id : UUID
  --
  full_name : varchar
  status : varchar
}

entity BrokerageApplication {
  * application_id : UUID
  --
  * customer_id : UUID
  status : varchar
  created_at : timestamp
  updated_at : timestamp
}

entity Consent {
  * consent_id : UUID
  --
  * application_id : UUID
  type : varchar
  document_version : varchar
  accepted_at : timestamp
}

entity BrokerageAccount {
  * account_id : UUID
  --
  * application_id : UUID
  * customer_id : UUID
  opened_at : timestamp
}

entity StatusHistory {
  * history_id : UUID
  --
  * application_id : UUID
  old_status : varchar
  new_status : varchar
  changed_at : timestamp
}

Customer ||--o{ BrokerageApplication
BrokerageApplication ||--o{ Consent
BrokerageApplication ||--o| BrokerageAccount
BrokerageApplication ||--o{ StatusHistory
@enduml
